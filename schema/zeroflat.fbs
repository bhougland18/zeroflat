// zeroflat.fbs — source of truth for the Rust↔Dart UI bridge.
//
// IMPORTANT: every component table carries `id: string (required)`.
// This id is the stable Patrol finder — it maps to ValueKey(id) in Flutter
// and must be identical across re-renders of the same logical component.
//
// Ordering note: `union StacNode` is declared before its member tables so
// component tables can reference it without a forward reference to a union
// (FlatBuffers resolves forward refs to tables but not to unions).
//
// Codegen (run inside `nix develop`):
//   just codegen
//     → flatc --dart  -o lib/src/generated/  schema/zeroflat.fbs
//     → flatc --rust  -o native/src/generated/ schema/zeroflat.fbs

namespace zeroflat;

// ── Primitive enums ───────────────────────────────────────────────────────────

enum Brightness   : ubyte { Light = 0, Dark }
enum Axis         : ubyte { Horizontal = 0, Vertical }
enum ButtonVariant: ubyte { Primary = 0, Secondary, Outline, Destructive, Ghost }
enum ButtonSize   : ubyte { Xs = 0, Sm, Md, Lg }
enum ToastVariant : ubyte { Primary = 0, Destructive }
enum SheetSide    : ubyte { Top = 0, Bottom, Left, Right }
enum BadgeVariant : ubyte { Primary = 0, Secondary, Outline, Destructive }
enum AlertVariant : ubyte { Primary = 0, Destructive }
enum SelectGroupVariant : ubyte { Checkbox = 0, Radio }
enum CellType : ubyte { Text = 0, Int, Float, Bool, Date, Null }
enum SvgSourceType : ubyte { Asset = 0, Network, String, Memory }
enum BoxFit : ubyte { Contain = 0, Cover, Fill, FitWidth, FitHeight, None, ScaleDown }

enum ColorToken : ubyte {
  Primary = 0,
  PrimaryForeground,
  Secondary,
  SecondaryForeground,
  Muted,
  MutedForeground,
  Destructive,
  DestructiveForeground,
  Error,
  ErrorForeground,
  Background,
  Foreground,
  Card,
  Border,
  Barrier,
}

enum TypographyToken : ubyte {
  Xs3 = 0, Xs2, Xs, Sm, Md, Lg,
  Xl, Xl2, Xl3, Xl4, Xl5, Xl6, Xl7, Xl8,
}

// ── Shared value type ─────────────────────────────────────────────────────────

// Table (not struct) so the field is an optional reference — absent = no padding.
table EdgeInsets {
  top:float;
  right:float;
  bottom:float;
  left:float;
}

// ── Node union — declared here so component tables below can reference it ─────
// Member tables are defined further down; FlatBuffers resolves table forward refs.

union StacNode {
  Theme,
  Scaffold,
  Header,
  Divider,
  Button,
  TextField,
  Switch,
  Checkbox,
  Card,
  Dialog,
  Badge,
  Avatar,
  Progress,
  Tabs,
  Slider,
  Alert,
  SelectGroup,
  Accordion,
  Breadcrumb,
  VirtualList,
  WebView,
  Svg,
}

// Dart's FlatBuffers codegen does not support vectors of unions ([StacNode]).
// NodeSlot is a one-field wrapper table so Header.suffixes, Header.actions,
// and Dialog.actions can be [NodeSlot] — vectors of tables — instead.
table NodeSlot {
  node:StacNode;
}

// ── Action tables ─────────────────────────────────────────────────────────────

table ActionUpdateState {
  key:string (required);   // RDF predicate or KV path; Rust defines the key space.
  value:string;            // Serialised value; type is determined by the Rust schema.
}

table ActionNavigate {
  route:string (required);
  args:string;             // OpaqueJson escape hatch — prefer typed Conduit messages.
}

table ToastConfig {
  title:string (required);
  description:string;
  variant:ToastVariant = Primary;
}

// Overlay actions carry pre-serialised StacRoot bytes rather than an inline
// StacNode. This avoids a StacAction ↔ StacNode circular union dependency.
// Flutter parses the bytes with getRootAsStacRoot() and presents the result
// as a modal overlay — identical to how a top-level UiUpdate is handled.
table ActionShowDialog {
  dialog_fbs:[ubyte] (required);
}

table ActionShowSheet {
  side:SheetSide = Bottom;
  sheet_fbs:[ubyte] (required);
}

table ActionShowToast {
  toast:ToastConfig (required);
}

table ActionCustom {
  name:string (required);
  payload:string;          // OpaqueJson escape hatch.
}

// Sent by Flutter when the user scrolls outside the current VirtualList window.
// Rust responds with a new UiUpdate carrying the requested window.
table ActionRequestWindow {
  list_id:string (required);
  offset:uint64;
  size:uint = 100;
}

union StacAction {
  ActionUpdateState,
  ActionNavigate,
  ActionShowDialog,
  ActionShowSheet,
  ActionShowToast,
  ActionCustom,
  ActionRequestWindow,
}

// ── Component tables ──────────────────────────────────────────────────────────
//
// Every table carries `id: string (required)` — the stable Patrol finder.
// Field ordering: required strings first, optional strings, sub-nodes, scalars.

table Theme {
  id:string (required);
  child:StacNode;
  brightness:Brightness = Light;
  border_radius:float;
  border_width:float;
  touch:bool = true;
}

table Scaffold {
  id:string (required);
  header:StacNode;
  content:StacNode;
  footer:StacNode;
  background_color:ColorToken = Background;
}

table Header {
  id:string (required);
  title:string;
  title_node:StacNode;
  suffixes:[NodeSlot];
  actions:[NodeSlot];
}

table Divider {
  id:string (required);
  axis:Axis = Horizontal;
  color:ColorToken = Border;
  thickness:float = 1.0;
  padding:EdgeInsets;
}

table Button {
  id:string (required);
  label:string;
  child:StacNode;
  prefix_icon:StacNode;
  suffix_icon:StacNode;
  variant:ButtonVariant = Primary;
  size:ButtonSize = Md;
  on_press:StacAction;
}

table TextField {
  id:string (required);
  label:string;
  description:string;
  hint:string;
  error:string;
  value:string;            // Current text — renderer sets controller initial value; local edits take over after first render.
  prefix:StacNode;
  suffix:StacNode;
  obscure_text:bool = false;
  on_change:StacAction;
  on_submit:StacAction;
}

table Switch {
  id:string (required);
  label:string;
  description:string;
  value:bool = false;
  enabled:bool = true;
  on_change:StacAction;
  semantic_label:string;
}

table Checkbox {
  id:string (required);
  label:string;
  description:string;
  error:string;
  value:bool = false;
  enabled:bool = true;
  leading_label:bool = false;
  on_change:StacAction;
  semantic_label:string;
}

table Card {
  id:string (required);
  title:string;
  title_node:StacNode;
  subtitle:string;
  subtitle_node:StacNode;
  child:StacNode;
}

table Dialog {
  id:string (required);
  actions:[NodeSlot];
  title:string;
  title_node:StacNode;
  body:string;
  body_node:StacNode;
  axis:Axis = Vertical;
}

table Badge {
  id:string (required);
  label:string;
  child:StacNode;
  variant:BadgeVariant = Primary;
}

table Avatar {
  id:string (required);
  image_url:string;
  fallback_label:string;
  size:float = 40.0;
}

table Progress {
  id:string (required);
  value:float = -1.0; // -1.0 = indeterminate
  label:string;
}

table Tab {
  id:string (required);
  label:string;
  label_node:StacNode;
  content:StacNode (required);
}

table Tabs {
  id:string (required);
  tabs:[Tab] (required);
  initial_index:int = 0;
  on_change:StacAction;
}

table Slider {
  id:string (required);
  value:float = 0.0;
  label:string;
  description:string;
  on_change:StacAction;
}

table Alert {
  id:string (required);
  title:string;
  title_node:StacNode;
  subtitle:string;
  subtitle_node:StacNode;
  icon:StacNode;
  variant:AlertVariant = Primary;
}

table SelectGroupItem {
  id:string (required);
  label:string;
  label_node:StacNode;
  description:string;
  value:string (required);
}

table SelectGroup {
  id:string (required);
  items:[SelectGroupItem] (required);
  values:[string]; // Selected values
  label:string;
  description:string;
  variant:SelectGroupVariant = Radio;
  on_change:StacAction;
}

table AccordionItem {
  id:string (required);
  title:string;
  title_node:StacNode;
  content:StacNode (required);
  icon:StacNode;
  initially_expanded:bool = false;
}

table Accordion {
  id:string (required);
  items:[AccordionItem] (required);
}

table BreadcrumbItem {
  id:string (required);
  label:string;
  label_node:StacNode;
  on_press:StacAction;
  current:bool = false;
}

table Breadcrumb {
  id:string (required);
  items:[BreadcrumbItem] (required);
}

// ── VirtualList — windowed lazy rendering for large datasets ──────────────────
//
// Rust sends total_rows + a small window of rows (~100–500). Flutter renders a
// ListView.builder(itemCount: total_rows); when the scroll position approaches
// the window boundary it dispatches ActionRequestWindow and Rust replies with
// a new UiUpdate containing the next window. Columns are derived from the Arrow
// schema on the Rust side — CellType carries the type hint Flutter needs for
// alignment and formatting.

table ColumnDef {
  key:string (required);    // Arrow field name; maps to ValueKey on the cell.
  label:string;             // Display header. Defaults to key if absent.
  type:CellType = Text;
  width:float;              // Logical pixels; 0.0 = auto.
}

table ListCell {
  type:CellType = Text;
  value:string;             // Always string-encoded. CellType drives alignment/formatting.
}

table ListRow {
  id:string (required);     // Stable row identity — typically the primary key.
  cells:[ListCell] (required);
}

table VirtualList {
  id:string (required);
  total_rows:uint64;        // Full result-set size for ListView.builder itemCount.
  columns:[ColumnDef] (required);
  window_start:uint64;      // Row offset of the first entry in `rows`.
  rows:[ListRow] (required);
  row_height:float;         // 0.0 = variable height (slightly less efficient).
}

// ── WebView — embeds a web view at the given URL ──────────────────────────────
//
// Intended for panels backed by a local server (e.g. perspective-server for
// Arrow/DataFusion analytics). The Rust side starts the server, resolves the
// URL, and sends this node; Flutter renders webview_flutter pointed at it.

table WebView {
  id:string (required);
  url:string (required);
}

// ── Svg — animated SVG via zeroflat_svg companion package ────────────────────
//
// Rendered by zeroflat_svg (depends on full_svg_flutter ^1.1.1).
// Static SVGs use FSvgPicture directly; animated SVGs use AnimatedSvgController
// which can be driven by ActionSvgControl actions from Rust.
// color_filter omitted from v1 — needs a typed FlatBuffer representation.

table Svg {
  id:string (required);
  source:string (required);      // Asset path, network URL, raw SVG string, or memory key.
  source_type:SvgSourceType = Asset;
  width:float;                   // 0.0 = unconstrained.
  height:float;                  // 0.0 = unconstrained.
  fit:BoxFit = Contain;
  auto_play:bool = true;
  loop:bool = true;
  playback_rate:float = 1.0;
}

// ── Bridge envelopes ───────────────────────────────────────────────────────────
//
// Rust → Dart:  UiUpdate signal carries a StacRoot FlatBuffer.
// Dart → Rust:  UiAction signal carries a UiActionEnvelope FlatBuffer.

table StacRoot {
  schema_version:ushort = 1;
  node:StacNode;
}

table UiActionEnvelope {
  action:StacAction;
}

root_type StacRoot;
